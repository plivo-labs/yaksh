# Copy to docker/.env. Provider keys, models and limits are on the Settings page, not here.

# Bearer token of the API and the console.
YAKSH_API_TOKEN=

# Encrypts the keys saved on the Settings page. 32 characters or more: openssl rand -base64 32
# Keep a copy. Without it, the saved keys are lost.
YAKSH_ENCRYPTION_KEY=

# Public https:// URL that goes to port 8770 of the worker. Phone calls need it.
YAKSH_PUBLIC_URL=

# Optional: allow trigger URLs on http and private addresses. Default: false.
YAKSH_ALLOW_PRIVATE_HOSTS=

# Optional: conversations on one worker at the same time. Default: 4.
YAKSH_MAX_ACTIVE_CONVERSATIONS=

# Optional: S3-compatible file storage. Docker Compose defaults to its storage service.
YAKSH_S3_ENDPOINT=
YAKSH_S3_BUCKET=
YAKSH_S3_ACCESS_KEY=
YAKSH_S3_SECRET_KEY=
