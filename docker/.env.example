# Yaksha settings. Copy this file to docker/.env for Docker Compose,
# or to .env in the folder you start yaksha-server from.
# A line that is commented out uses the default shown.

# ---- Required ----

# The token for the console, the API and the CLI. Use a long random string.
YAKSHA_API_TOKEN=

# ---- Phone calls (Plivo) ----

# Your Plivo account. Yaksha places and receives the test calls with it.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# The public HTTPS address that reaches the worker's stream port (8770).
# Plivo sends the call audio and the call events here. scripts/tunnel.sh prints one.
YAKSHA_PUBLIC_URL=
# The Plivo Application that sends an outbound agent's calls to this worker.
# Needed only to test agents that call Yaksha.
# YAKSHA_PLIVO_APP_ID=
# The Plivo numbers Yaksha may use, comma-separated in E.164 form.
# Empty uses every voice number on the account. A listed number missing from the account stops the worker.
# YAKSHA_PLIVO_NUMBERS=
# The worker port for Plivo's answer URL, audio stream and callbacks.
# YAKSHA_STREAM_PORT=8770
# How long Yaksha lets the agent's number ring before it gives up.
# YAKSHA_RING_TIMEOUT_S=30
# How long a number rests after a test before the next test may use it,
# so a late call from an earlier test does not reach the next one.
# YAKSHA_NUMBER_REST_S=300

# ---- The caller: speech to text, voice and model ----

# Speech to text for the agent's words.
DEEPGRAM_API_KEY=
# DEEPGRAM_BASE_URL=https://api.deepgram.com
# YAKSHA_DEEPGRAM_MODEL=nova-3
# The caller's voices.
ELEVENLABS_API_KEY=
# The caller's model. Also used to write scenarios, and to judge calls when the judge settings are empty.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# PERSONA_LLM_MODEL=gpt-6-luna
# Unset asks a reasoning model for effort "none", for the fastest reply.
# PERSONA_LLM_REASONING_EFFORT=

# ---- Scenario generation ----

# The model that writes test scenarios. Unset uses PERSONA_LLM_MODEL.
# GENERATION_LLM_MODEL=
# GENERATION_LLM_REASONING_EFFORT=max
# The time one generation request may take. High effort takes minutes.
# GENERATION_LLM_TIMEOUT_S=300

# ---- Judges ----

# The model that judges calls. An empty value turns the judges off.
# JUDGE_LLM_MODEL=gpt-6-luna
# JUDGE_LLM_REASONING_EFFORT=medium
# The time one judge request may take.
# JUDGE_LLM_TIMEOUT_S=60
# The most output tokens for one judge answer. Reasoning tokens count too.
# JUDGE_MAX_OUTPUT_TOKENS=8000
# A separate key and address for the judge model. Unset uses OPENAI_API_KEY and OPENAI_BASE_URL.
# JUDGE_OPENAI_API_KEY=
# JUDGE_OPENAI_BASE_URL=
# The time one request of the instruction and hallucination judges may take. They read the agent's whole config or documents.
# JUDGE_SOURCES_TIMEOUT_S=180
# The most text one judge request holds. Larger sources make that judge's item an error.
# JUDGE_MAX_INPUT_CHARS=400000
# Optional. With a key, Jev (TypeSafe's classifier) answers each criterion first, and a confident pass needs no model call.
# Call transcripts are sent to TypeSafe.
# TYPESAFE_API_KEY=
# How sure Jev must be to publish a pass.
# JEV_PASS_BAR=0.95

# ---- Review and labels ----

# The share of judged calls that go to the audit lane, where blind labels measure the judges.
# AUDIT_SAMPLE_RATE=0.1
# The most audit calls the review queue offers for one week of calls.
# AUDIT_WEEKLY_BUDGET=30

# ---- Outbound agents (agents that call Yaksha) ----

# Signs every trigger request, so the agent's server can check it came from Yaksha.
# YAKSHA_WEBHOOK_SIGNING_KEY=
# Allow trigger URLs on private or local addresses. For development only.
# YAKSHA_ALLOW_PRIVATE_TRIGGERS=false
# Secrets a trigger can use in its headers or body as {{env.YAKSHA_TRIGGER_<NAME>}}. Add one line for each secret.
# YAKSHA_TRIGGER_ACME_AUTH=

# ---- Limits and defaults ----

# The longest a call may last when a request does not say.
# YAKSHA_DEFAULT_MAX_DURATION_S=300
# How many agent turns the caller answers before it says goodbye, when a request does not say.
# YAKSHA_DEFAULT_MAX_TURNS=20
# The most calls one run may start: scenarios times repeats. Retries do not count.
# YAKSHA_MAX_RUN_CONVERSATIONS=200
# The most repeats of each scenario in one run.
# YAKSHA_MAX_RUN_REPEATS=10
# The most retries a run may ask for. A run that does not say gets 1, or this value when it is lower.
# YAKSHA_MAX_RUN_RETRIES=3
# The longest wait a run may ask for between call starts.
# YAKSHA_MAX_RUN_START_INTERVAL_S=600
# How many calls one worker runs at the same time. Keep it at or below your Plivo account's call limit.
# YAKSHA_MAX_ACTIVE_CONVERSATIONS=4
# The time zone of the date the caller is told is today. The judges use the same date.
# YAKSHA_TIMEZONE=UTC

# ---- File storage (any S3-compatible service) ----

# Keeps uploaded documents. Docker Compose uses its own storage service when these are unset.
# Without an endpoint outside Docker, uploads are off.
# YAKSHA_S3_ENDPOINT=
# YAKSHA_S3_BUCKET=yaksha
# YAKSHA_S3_ACCESS_KEY=
# YAKSHA_S3_SECRET_KEY=
# YAKSHA_S3_REGION=us-east-1

# ---- Worker and evaluator tuning (change only when you need to) ----

# How often a worker looks for queued calls.
# YAKSHA_WORKER_POLL_INTERVAL_S=0.5
# How often a worker renews its claim on its calls.
# YAKSHA_WORKER_HEARTBEAT_S=1.0
# How long a claim lasts. After that, another worker may take over a call whose worker stopped.
# YAKSHA_WORKER_LEASE_S=30
# How long a stopping process waits for a call to hang up, and for the database to close.
# YAKSHA_END_TIMEOUT_S=5.0
# How often the evaluator looks for calls to judge.
# YAKSHA_EVALUATOR_POLL_INTERVAL_S=2.0
# How long the evaluator's claim on a call lasts.
# YAKSHA_EVALUATOR_LEASE_S=60
# How many calls one evaluator judges at the same time.
# YAKSHA_EVALUATOR_CONCURRENCY=2
# How many judge model requests one evaluator sends at the same time.
# YAKSHA_EVALUATOR_JUDGE_CONCURRENCY=8

# ---- Only when you run without Docker ----
# Docker Compose sets these four itself.

# YAKSHA_DATABASE_URL=postgresql+asyncpg://yaksha:yaksha@localhost:5432/yaksha
# YAKSHA_API_HOST=127.0.0.1
# YAKSHA_API_PORT=8000
# Where the worker writes call recordings. The API reads them from the same folder.
# YAKSHA_DATA_DIR=./data
# The built console, which the API serves.
# YAKSHA_FRONTEND_DIST=./frontend/dist
